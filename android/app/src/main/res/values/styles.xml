<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème sombre, plein écran, sans barre d'action. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/game_background</item>
        <item name="colorPrimaryDark">@color/game_background</item>
        <item name="colorAccent">#3EE6FF</item>
        <item name="android:windowBackground">@color/game_background</item>
        <item name="android:statusBarColor">@color/game_background</item>
        <item name="android:navigationBarColor">@color/game_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/game_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Écran de démarrage (Android 12+ : icône sur fond sombre ; avant : image splash). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
